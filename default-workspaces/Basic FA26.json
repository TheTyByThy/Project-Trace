  "activeSheet": 0,
  "math": [
    {
      "id": "m1",
      "name": "Combined G",
      "expr": "hypot('CG Accel Lateral', 'CG Accel Longitudinal')",
      "unit": "G",
      "dps": 2,
      "description": "Total horizontal acceleration — the radius of the friction circle.",
      "enabled": true
    },
    {
      "id": "m2",
      "name": "Steering Rate",
      "expr": "derivative('Steering Angle')",
      "unit": "deg/s",
      "dps": 0,
      "description": "How fast the driver turns the wheel; spikes show corrections.",
      "enabled": true
    },
    {
      "id": "m3",
      "name": "Throttle Brake Overlap",
      "expr": "choose('Throttle Pos' > 5 and 'Brake Pos' > 5, 1, 0)",
      "unit": "",
      "dps": 2,
      "description": "1 while throttle and brake are both applied.",
      "enabled": true
    },
    {
      "id": "m4",
      "name": "Coasting",
      "expr": "choose('Throttle Pos' < 2 and 'Brake Pos' < 2 and 'Ground Speed' > 30, 1, 0)",
      "unit": "",
      "dps": 2,
      "description": "1 while neither pedal is used (lost time!).",
      "enabled": true
    },
    {
      "id": "m5",
      "name": "Full Throttle",
      "expr": "choose('Throttle Pos' > 98, 1, 0)",
      "unit": "",
      "dps": 2,
      "description": "1 at full throttle. Mean over a lap = full-throttle fraction.",
      "enabled": true
    },
    {
      "id": "m6",
      "name": "Braking Time Lap",
      "expr": "integrate_lap(choose('Brake Pos' > 5, 1, 0))",
      "unit": "s",
      "dps": 1,
      "description": "Accumulated braking time within the lap.",
      "enabled": true
    },
    {
      "id": "m7",
      "name": "Damper Velocity FL",
      "expr": "derivative('Damper Travel FL')",
      "unit": "mm/s",
      "dps": 0,
      "description": "Damper speed (FL). Positive = bump, negative = rebound.",
      "enabled": true
    },
    {
      "id": "m8",
      "name": "Damper Velocity FR",
      "expr": "derivative('Damper Travel FR')",
      "unit": "mm/s",
      "dps": 0,
      "description": "Damper speed (FR). Positive = bump, negative = rebound.",
      "enabled": true
    },
    {
      "id": "m9",
      "name": "Damper Velocity RL",
      "expr": "derivative('Damper Travel RL')",
      "unit": "mm/s",
      "dps": 0,
      "description": "Damper speed (RL). Positive = bump, negative = rebound.",
      "enabled": true
    },
    {
      "id": "m10",
      "name": "Damper Velocity RR",
      "expr": "derivative('Damper Travel RR')",
      "unit": "mm/s",
      "dps": 0,
      "description": "Damper speed (RR). Positive = bump, negative = rebound.",
      "enabled": true
    },
    {
      "id": "m11",
      "name": "Tyre Temp Avg FL",
      "expr": "('Tire Temp Inner FL' + 'Tire Temp Middle FL' + 'Tire Temp Outer FL') / 3",
      "unit": "C",
      "dps": 1,
      "description": "Average surface temperature across the FL tread.",
      "enabled": true
    },
    {
      "id": "m12",
      "name": "Tyre Temp Avg FR",
      "expr": "('Tire Temp Inner FR' + 'Tire Temp Middle FR' + 'Tire Temp Outer FR') / 3",
      "unit": "C",
      "dps": 1,
      "description": "Average surface temperature across the FR tread.",
      "enabled": true
    },
    {
      "id": "m13",
      "name": "Tyre Temp Avg RL",
      "expr": "('Tire Temp Inner RL' + 'Tire Temp Middle RL' + 'Tire Temp Outer RL') / 3",
      "unit": "C",
      "dps": 1,
      "description": "Average surface temperature across the RL tread.",
      "enabled": true
    },
    {
      "id": "m14",
      "name": "Tyre Temp Avg RR",
      "expr": "('Tire Temp Inner RR' + 'Tire Temp Middle RR' + 'Tire Temp Outer RR') / 3",
      "unit": "C",
      "dps": 1,
      "description": "Average surface temperature across the RR tread.",
      "enabled": true
    },
    {
      "id": "m15",
      "name": "Tyre Temp Spread FL",
      "expr": "'Tire Temp Inner FL' - 'Tire Temp Outer FL'",
      "unit": "C",
      "dps": 1,
      "description": "Inner minus outer temperature (FL) — a camber indicator.",
      "enabled": true
    },
    {
      "id": "m16",
      "name": "Tyre Temp Spread FR",
      "expr": "'Tire Temp Inner FR' - 'Tire Temp Outer FR'",
      "unit": "C",
      "dps": 1,
      "description": "Inner minus outer temperature (FR) — a camber indicator.",
      "enabled": true
    },
    {
      "id": "m17",
      "name": "Tyre Temp Spread RL",
      "expr": "'Tire Temp Inner RL' - 'Tire Temp Outer RL'",
      "unit": "C",
      "dps": 1,
      "description": "Inner minus outer temperature (RL) — a camber indicator.",
      "enabled": true
    },
    {
      "id": "m18",
      "name": "Tyre Temp Spread RR",
      "expr": "'Tire Temp Inner RR' - 'Tire Temp Outer RR'",
      "unit": "C",
      "dps": 1,
      "description": "Inner minus outer temperature (RR) — a camber indicator.",
      "enabled": true
    },
    {
      "id": "m19",
      "name": "Rake",
      "expr": "'Ride Height Rear' - 'Ride Height Front'",
      "unit": "mm",
      "dps": 1,
      "description": "Rear minus front ride height.",
      "enabled": true
    },
    {
      "id": "m20",
      "name": "Total Downforce",
      "expr": "'Aero Downforce F' + 'Aero Downforce R'",
      "unit": "N",
      "dps": 0,
      "description": "Front + rear downforce.",
      "enabled": true
    },
    {
      "id": "m21",
      "name": "Aero Balance",
      "expr": "choose('Aero Downforce F' + 'Aero Downforce R' > 500, 100 * 'Aero Downforce F' / ('Aero Downforce F' + 'Aero Downforce R'), invalid())",
      "unit": "%",
      "dps": 1,
      "description": "Front share of total downforce (invalid at low speed).",
      "enabled": true
    },
    {
      "id": "m22",
      "name": "Aero Efficiency",
      "expr": "choose('Aero Drag' > 100, ('Aero Downforce F' + 'Aero Downforce R') / 'Aero Drag', invalid())",
      "unit": "",
      "dps": 2,
      "description": "Downforce / drag (L/D).",
      "enabled": true
    },
    {
      "id": "m23",
      "name": "Front Load Share",
      "expr": "100 * ('Tire Load FL' + 'Tire Load FR') / max('Tire Load FL' + 'Tire Load FR' + 'Tire Load RL' + 'Tire Load RR', 1)",
      "unit": "%",
      "dps": 1,
      "description": "Share of vertical load on the front axle.",
      "enabled": true
    },
    {
      "id": "m24",
      "name": "Lateral Load Transfer",
      "expr": "100 * (('Tire Load FR' + 'Tire Load RR') - ('Tire Load FL' + 'Tire Load RL')) / max('Tire Load FL' + 'Tire Load FR' + 'Tire Load RL' + 'Tire Load RR', 1)",
      "unit": "%",
      "dps": 1,
      "description": "Right-minus-left load as a share of total (positive = loaded on the right).",
      "enabled": true
    },
    {
      "id": "m25",
      "name": "Rear Wheelspin",
      "expr": "max('Tire Slip Ratio RL', 'Tire Slip Ratio RR')",
      "unit": "%",
      "dps": 1,
      "description": "Largest rear slip ratio — traction loss on exits.",
      "enabled": true
    },
    {
      "id": "m26",
      "name": "Front Lockup",
      "expr": "min('Tire Slip Ratio FL', 'Tire Slip Ratio FR')",
      "unit": "%",
      "dps": 1,
      "description": "Most negative front slip ratio — lock-ups under braking.",
      "enabled": true
    },
    {
      "id": "m27",
      "name": "Brake Temp Front Avg",
      "expr": "('Brake Temp FL' + 'Brake Temp FR') / 2",
      "unit": "C",
      "dps": 0,
      "description": "Mean front disc temperature.",
      "enabled": true
    },
    {
      "id": "m28",
      "name": "Brake Temp Rear Avg",
      "expr": "('Brake Temp RL' + 'Brake Temp RR') / 2",
      "unit": "C",
      "dps": 0,
      "description": "Mean rear disc temperature.",
      "enabled": true
