{
  "name": "project-trace",
  "productName": "Project-Trace",
  "version": "1.0.0",
  "description": "MoTeC-style telemetry analysis for Assetto Corsa (Telemetrick) CSV exports. Windows & macOS.",
  "author": "Tyler Fielding-Martin",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "vite build && node scripts/launch.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "screenshots": "vite build && node scripts/screenshots.mjs",
    "dist:win": "vite build && electron-builder --win",
    "dist:mac": "vite build && electron-builder --mac",
    "dist": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.projecttrace.app",
    "productName": "Project-Trace",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "sample-data",
        "to": "sample-data"
      },
      {
        "from": "default-workspaces",
        "to": "default-workspaces"
      },
      {
        "from": "default-tracks",
        "to": "default-tracks"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^6.4.5",
    "vitest": "^4.1.12",
    "zustand": "^5.0.16"
  }
}
